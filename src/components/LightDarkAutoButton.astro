---
import IconSun from '~/icons/sun.svg'
import IconMoon from '~/icons/moon.svg'
import siteConfig from '~/site.config'
let lightTheme = siteConfig.themes.include[0]
let darkTheme = siteConfig.themes.include[1]
---

<button
  id="theme-change-button"
  class="block ml-auto cursor-pointer"
  data-light={lightTheme}
  data-dark={darkTheme}
  aria-label="Toggle light/dark mode"
>
  <IconSun id="icon-light" class="hidden size-6 text-accent" />
  <IconMoon id="icon-dark" class="hidden size-6 text-accent" />
</button>

<script>
  import { motionDisabled } from '~/scripts/motion'

  const themeButton = document.getElementById('theme-change-button')
  const lightThemeId = themeButton?.getAttribute('data-light')
  const darkThemeId = themeButton?.getAttribute('data-dark')
  const sunIcon = themeButton?.querySelector('#icon-light')
  const moonIcon = themeButton?.querySelector('#icon-dark')

  const resolveActive = () => {
    const stored = localStorage.getItem('data-theme')
    if (stored === lightThemeId) return lightThemeId
    if (stored === darkThemeId) return darkThemeId
    // 'auto' or unset — fall back to the actually-applied theme on <html>
    return document.documentElement.getAttribute('data-theme') === lightThemeId
      ? lightThemeId
      : darkThemeId
  }

  // Show the icon for the theme you'd switch TO (sun when dark, moon when light)
  const updateIcons = (active: string | null | undefined) => {
    if (active === lightThemeId) {
      sunIcon?.classList.add('hidden')
      moonIcon?.classList.remove('hidden')
    } else {
      sunIcon?.classList.remove('hidden')
      moonIcon?.classList.add('hidden')
    }
  }

  updateIcons(resolveActive())

  themeButton?.addEventListener('click', () => {
    const active = resolveActive()
    const newTheme = active === lightThemeId ? darkThemeId : lightThemeId
    if (!newTheme) return

    const apply = () => {
      localStorage.setItem('data-theme', newTheme)
      document.documentElement.setAttribute('data-theme', newTheme)
      updateIcons(newTheme)
    }

    if (!document.startViewTransition || motionDisabled()) {
      apply()
      return
    }

    // Origin of the circular wipe, read by the `vt-theme-wipe` keyframes.
    const { top, left, width, height } = themeButton.getBoundingClientRect()
    document.documentElement.style.setProperty('--vt-x', `${left + width / 2}px`)
    document.documentElement.style.setProperty('--vt-y', `${top + height / 2}px`)

    const transition = document.startViewTransition({ update: apply, types: ['theme'] })
    // `ready` rejects with "Transition was skipped" whenever the browser drops
    // the animation (another transition already running, tab hidden, …). The
    // theme still applies, so swallow it rather than leaking an unhandled
    // rejection into the console.
    transition.ready.catch(() => {})
  })
</script>
