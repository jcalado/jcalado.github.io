---
interface Props {
  title?: string
  titlePieces?: string[]
  transitionName?: string
}

const { title, titlePieces, transitionName } = Astro.props

const splitPath: string[] = Astro.url.pathname
  .split('/')
  .filter(Boolean)
  .map((part) => decodeURIComponent(part))

const pieces = titlePieces ?? splitPath

if (pieces.length === 0) {
  pieces.push('home')
}

const titleFromPieces = pieces.map((part) => `/ ${part}`)
const lastIndex = titleFromPieces.length - 1
---

<div class="page-header border-0 border-accent/30 bg-accent/6 rounded-xl inline-block py-2.5 pl-3 pr-4 mt-5 md:mt-8">
  <h1 class="text-accent flex flex-wrap gap-y-2 gap-x-3.5">
    {title ? (
      <span>// {title}</span>
    ) : (
      titleFromPieces.map((part, i) => (
        <span
          style={
            transitionName && i === lastIndex
              ? `view-transition-name:${transitionName};view-transition-class:tag-label`
              : undefined
          }
        >
          {part}
        </span>
      ))
    )}
  </h1>
</div>
